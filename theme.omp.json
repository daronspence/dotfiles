{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "upgrade": {
    "source": "cdn",
    "interval": "168h",
    "auto": false,
    "notice": false
  },
  "blocks": [
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "notes": "OS information",
          "leading_diamond": "\ue0b6",
          "template": "{{ .Icon }} {{ .HostName }} ",
          "foreground": "#00c983",
          "background": "#003543",
          "type": "os",
          "style": "diamond"
        },
        {
          "notes": "Path information",
          "properties": {
            "folder_icon": "\uf115",
            "folder_separator_icon": "/",
            "home_icon": "\ueb06",
            "style": "full"
          },
          "template": " <#000>\uf07b \uea9c</> {{ .Path }} ",
          "foreground": "#ffffff",
          "powerline_symbol": "\ue0b0",
          "background": "#DA627D",
          "type": "path",
          "style": "powerline"
        },
        {
          "notes": "Git information",
          "properties": {
            "branch_icon": " <#ffffff>\ue0a0 </>",
            "fetch_stash_count": true,
            "fetch_status": false,
            "fetch_upstream_icon": true,
            "branch_max_length": 25
          },
          "template": " ➜ ({{ .UpstreamIcon }}{{ (abbrev 50 .HEAD) }}{{ if gt .StashCount 0 }} \ueb4b {{ .StashCount }}{{ end }}) ",
          "foreground": "#ffffff",
          "powerline_symbol": "\ue0b0",
          "background": "#FCA17D",
          "type": "git",
          "style": "powerline"
        },
        {
          "notes": "Package Manager information (node)",
          "template": " \ue718 {{ if .PackageManagerIcon }}{{ .PackageManagerIcon }} {{ end }}{{ .Full }} ",
          "foreground": "#ffffff",
          "powerline_symbol": "\ue0b0",
          "background": "#76b367",
          "type": "node",
          "style": "powerline"
        },
        {
          "notes": "Time to execute",
          "properties": {
            "always_enabled": true
          },
          "template": " \ueba2 {{ .FormattedMs }} ",
          "foreground": "#ffffff",
          "powerline_symbol": "\ue0b0",
          "background": "#83769c",
          "type": "executiontime",
          "style": "powerline"
        },
        {
          "notes": "Current date information",
          "properties": {
            "time_format": "15:04:05"
          },
          "template": " \uf017 {{ .CurrentDate | date .Format }} ",
          "foreground": "#ffffff",
          "powerline_symbol": "\ue0b0",
          "background": "#33658A",
          "type": "time",
          "style": "powerline"
        },
        {
          "notes": "Status of the last command (error/etc)",
          "see_url": "https://ohmyposh.dev/docs/segments/system/status#status-template",
          "properties": {
            "always_enabled": true
          },
          "trailing_diamond": "\ue0b4",
          "template": " {{ if gt .Code 0 }}\uf421{{ else }}\uf469{{ end }} ",
          "foreground": "#ffffff",
          "powerline_symbol": "\ue0b0",
          "background": "#2e9599",
          "type": "status",
          "style": "diamond",
          "background_templates": [
            "{{ if gt .Code 0 }}red{{ end }}"
          ]
        }
      ]
    },
    {
      "type": "prompt",
      "alignment": "left",
      "segments": [
        {
          "template": "\ue3bf ",
          "foreground": "#cd5e42",
          "type": "root",
          "style": "plain"
        },
        {
          "template": " <#45F1C2><b>⚡</b></><b>{{ .UserName }}</b> <#26C6DA>❯</><#45F1C2>❯</>",
          "foreground": "#CD4277",
          "type": "text",
          "style": "plain"
        }
      ],
      "newline": true
    }
  ],
  "version": 3,
  "final_space": true
}
